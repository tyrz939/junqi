legend
, tile Grass
^ tile HouseRoof
| tile Fence
& tile HouseWall
: tile Dirt
* tile Garden
F prop town_flower_bed
S prop sign sign_farm {"talk": "sign_farm"}
L prop lamp_post
M prop town_milk_churn
f prop campfire farm_fire {"talk": "fire"}
B prop town_barn_doors barn_door {"talk": "barn_door", "label": "The barn"}
H prop town_hay_bale
A prop town_hen_coop farm_hens {"talk": "hen_coop"}
T prop town_trough
C prop town_farm_cart
s prop town_sacks
b prop barrel - {"loot": [{"item": "match", "qty": 4}]}
W prop town_woodpile
a prop apple_tree - {"loot": [{"item": "apple", "qty": 2}]}
h unit town_hen - south [[45, 4, 140], [50, 5, 200], [47, 6, 90]]
D unit town_hen_brown - west [[51, 3, 180], [46, 5, 120]]
E unit town_sheep - east [[45, 11, 400], [50, 13, 300]]
G unit town_sheep - east [[52, 10, 400], [48, 15, 300]]
I unit town_sheep - east [[54, 14, 400], [51, 11, 300]]
J unit town_sheep - east [[47, 14, 400], [44, 10, 300]]
K mark farm_door north
N mark farm_gate east
