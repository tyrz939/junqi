  "master": {
    "name": "Master", "faction": "undead", "controller": "ai",
    "strength": 18, "spirit": 12, "walk": 0.5, "run": 1, "aggro": 11, "leash": 60, "bounds": 1,
    "book": ["icebolt_ai", "melee"], "respawn": 0, "autoRegen": true, "loot": [], "sprite": "school_master"
  },
  "caretaker": {
    "name": "The Caretaker", "faction": "undead", "controller": "ai",
    "strength": 70, "spirit": 24, "walk": 0.35, "run": 0.8, "aggro": 13, "leash": 140, "bounds": 1.25,
    "book": ["melee_stun", "melee_fast"], "respawn": 0, "autoRegen": true,
    "loot": [{ "item": "key_tower", "qty": 1, "chance": 1 }],
    "sprite": "school_caretaker", "boss": true, "nightOnly": true,
    "glow": { "radius": 70, "color": "#ffc070" },
    "resist": { "physical": 0.3, "frost": 0.2 },
    "phases": [
      {
        "hpBelow": 0.5, "book": ["melee_stun", "melee_fast"], "run": 1,
        "onEnter": [
          {
            "do": "send", "unit": "caretaker", "to": "school_caretaker_dark",
            "then": [{ "do": "toast", "text": "He puts the lamp out. The keys go on down the corridor, further off each time." }]
          }
        ]
      }
    ],
    "onDeath": [
      { "do": "flag", "flag": "school_caretaker_down" },
      { "do": "toast", "text": "The ring goes down all at once. Forty keys, and one of them is cut for the tower." }
    ]
  },
  "ringer": {
    "name": "The Timekeeper", "faction": "undead", "controller": "ai",
    "strength": 125, "spirit": 120, "walk": 0.3, "run": 0.7, "aggro": 16, "leash": 70, "bounds": 1.5,
    "book": ["melee_stun", "snake_ring", "icebolt_ai"], "respawn": 0, "autoRegen": true, "loot": [],
    "sprite": "school_ringer", "boss": true,
    "resist": { "physical": 0.5, "frost": 0.35, "fire": 0.35, "nature": 0.35, "blast": 0.35, "shock": 0.35 },
    "phases": [
      {
        "hpBelow": 0.75, "book": ["melee_stun", "snake_ring", "icebolt_ai"], "run": 0.8,
        "onEnter": [
          { "do": "switch", "prop": "school_belfry_brazier_a", "on": false },
          { "do": "switch", "prop": "school_belfry_brazier_b", "on": false },
          { "do": "switch", "prop": "school_belfry_cold_a", "on": false },
          { "do": "switch", "prop": "school_belfry_cold_b", "on": false },
          { "do": "show", "prop": "school_belfry_bud_a" },
          { "do": "show", "prop": "school_belfry_bud_b" },
          { "do": "shake", "amount": 3 },
          { "do": "toast", "text": "The bell goes. Every lamp in the belfry goes out with it, and the window is the only light left." }
        ]
      },
      {
        "hpBelow": 0.5, "book": ["melee_stun", "snake_ring", "icebolt_ai"], "run": 0.9,
        "onEnter": [
          { "do": "switch", "prop": "school_belfry_brazier_a", "on": true },
          { "do": "switch", "prop": "school_belfry_brazier_b", "on": true },
          { "do": "switch", "prop": "school_belfry_cold_a", "on": false },
          { "do": "switch", "prop": "school_belfry_cold_b", "on": false },
          { "do": "hide", "prop": "school_belfry_bud_a" },
          { "do": "hide", "prop": "school_belfry_bud_b" },
          { "do": "shake", "amount": 3 },
          { "do": "toast", "text": "The bell goes again and it is the middle of the afternoon. The floor is dry and the lamps are up." }
        ]
      },
      {
        "hpBelow": 0.25, "book": ["melee_stun", "snake_ring", "icebolt_ai"], "run": 1,
        "onEnter": [
          { "do": "switch", "prop": "school_belfry_brazier_a", "on": false },
          { "do": "switch", "prop": "school_belfry_brazier_b", "on": false },
          { "do": "switch", "prop": "school_belfry_cold_a", "on": false },
          { "do": "switch", "prop": "school_belfry_cold_b", "on": false },
          { "do": "show", "prop": "school_belfry_bud_a" },
          { "do": "show", "prop": "school_belfry_bud_b" },
          { "do": "spawn", "unit": "school_belfry_shade_1", "def": "shade", "at": "school_belfry_shade_a" },
          { "do": "spawn", "unit": "school_belfry_shade_2", "def": "shade", "at": "school_belfry_shade_b" },
          { "do": "spawn", "unit": "school_belfry_shade_3", "def": "shade", "at": "school_belfry_shade_c" },
          { "do": "shake", "amount": 4 },
          { "do": "toast", "text": "The bell goes a third time. Three of them are standing at the edge of the light and none of them came up the stair." }
        ]
      }
    ],
    "onDeath": [
      { "do": "flag", "flag": "school_cleared" },
      { "do": "location", "name": "ringer_down" },
      { "do": "despawn", "unit": "school_belfry_shade_1" },
      { "do": "despawn", "unit": "school_belfry_shade_2" },
      { "do": "despawn", "unit": "school_belfry_shade_3" },
      { "do": "switch", "prop": "school_belfry_brazier_a", "on": true },
      { "do": "switch", "prop": "school_belfry_brazier_b", "on": true },
      { "do": "toast", "text": "The rope goes slack and stays slack. The bell is still swinging, and it is not ringing." }
    ]
  }
}
