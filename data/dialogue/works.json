          }
        ],
        "node": "after"
      },
      {
        "node": "talk"
      }
    ],
    "nodes": {
      "talk": {
        "lines": [
          "Hut Two. Visitors sign the book. Not many visitors.",
          "I keep the watch, six to six. Nobody's come to take it off me, so I keep it."
        ]
      },
      "bag_in": {
        "lines": [
          "He takes the bag and turns it over, and does not open it.",
          "She always tied it like that. Tuesdays. After the Lovedays, before the lodge."
        ],
        "options": [
          {
            "label": "She went on to the lodge?",
            "actions": [
              {
                "do": "handin",
                "quest": "tuesday_reed_end"
              },
              {
                "do": "take",
                "item": "nurses_bag",
                "qty": 1
              },
              {
                "do": "quest",
                "quest": "tuesday_hut_two"
              }
            ]
          }
        ]
      },
      "lodge_offer": {
        "lines": [
          "She signed my book and went on up to the graveyard lodge to sign theirs. I watched her up the road.",
          "I'd like to know what their book says. And then I'd like not to."
        ],
        "options": [
          {
            "label": "I'll look",
            "actions": [
              {
                "do": "quest",
                "quest": "tuesday_hut_two"
              }
            ]
          },
          {
            "label": "Not now"
          }
        ]
      },
      "lodge_wait": {
        "lines": [
          "The lodge book, at the graveyard gate. Don't tell me what it says. Tell Mrs Allen, in Castle."
        ]
      },
      "after": {
        "lines": [
          "You've told Mrs Allen. Then it's told. Sign the book on your way, if you like."
        ]
      }
    }
  },
