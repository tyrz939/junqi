    "nodes": {
      "talk": {
        "lines": [
          "Hut Two. Book's there. Visitors sign. Not many visitors.",
          "Six to six. Nobody's come to take the watch off me, so I keep it."
        ]
      },
      "bag_in": {
        "lines": [
          "That's her bag. That's her knot, she always tied it so. I won't open it.",
          "Tuesdays. After the Lovedays, before the lodge. Signed my book at twenty past, every week."
        ],
        "options": [
          {
            "label": "She went on to the lodge?",
            "actions": [
              {
                "do": "handin",
                "quest": "tuesday_reed_end"
              },
              {
                "do": "take",
                "item": "nurses_bag",
                "qty": 1
              },
              {
                "do": "quest",
                "quest": "tuesday_hut_two"
              }
            ]
          }
        ]
      },
      "lodge_offer": {
        "lines": [
          "She signed my book and went on up to the graveyard lodge to sign theirs. I watched her up the road as far as the bend. That's in my book too.",
          "I'd like to know what their book has against her name. Never went up to ask. Not my post."
        ],
        "options": [
          {
            "label": "I'll look",
            "actions": [
              {
                "do": "quest",
                "quest": "tuesday_hut_two"
              }
            ]
          },
          {
            "label": "Not now"
          }
        ]
      },
      "lodge_wait": {
        "lines": [
          "The lodge book. Graveyard gate. Don't tell me what it says. Tell Mrs Allen, in Castle. Window with the card in it."
        ]
      },
      "after": {
        "lines": [
          "You've told Mrs Allen. Good. She'll have wanted it from somebody who'd seen the book. Sign mine on your way. I'll put the time."
        ]
      }
    }
  },
