    ],
    "nodes": {
      "offer": {
        "lines": [
          "Have you seen a black cat? He's called Sixpence. He hasn't come in since Sunday.",
          "I think he's in the churchyard, behind the church. I'm not allowed in there."
        ],
        "options": [
          {
            "label": "I'll look for him",
            "actions": [
              {
                "do": "quest",
                "quest": "sixpence"
              }
            ]
          },
          {
            "label": "Not now"
          }
        ]
      },
      "wait": {
        "lines": [
          "The churchyard is behind the church. Go up the lane by the church door. He likes the new stone best."
        ]
      },
      "in": {
        "lines": [
          "Sixpence! Where were you?",
          "He's cold. Mum says he's always cold now, but he still eats. Here, you can have my dinner. I had some."
        ],
        "options": [
          {
            "label": "Give him back",
            "actions": [
              {
                "do": "handin",
                "quest": "sixpence"
              },
              {
                "do": "spawn",
                "unit": "sixpence_home",
                "def": "town_cat_sixpence_home",
                "at": "fountain"
              }
            ]
          }
        ]
      },
      "after": {
        "lines": [
          "He sleeps on my bed now. He didn't use to. When the lamps come on he gets up and sits in the window."
        ]
      }
    }
  },
