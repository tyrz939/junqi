    "start": [
      {
        "node": "a"
      }
    ],
    "nodes": {
      "a": {
        "lines": [
          "Mind the pile. I sweep the square twice a day. Leaves in the morning. In the evening it's mostly salt."
        ]
      }
    }
  },
  "constable": {
