  "mrs_crewe": {
    "speaker": "Mrs Crewe",
    "start": [
      {
        "node": "a"
      }
    ],
    "nodes": {
      "a": {
        "lines": [
          "Seeds and cuttings. I'll swap: two pansies for a nasturtium, two nasturtiums for a honeylace lily.",
          "Julie up the lane used to have the lot off me. She never said what for."
        ],
        "options": [
          {
            "label": "Two pansies for a nasturtium",
            "actions": [
              {
                "do": "if",
                "when": [
                  {
                    "if": "hasItem",
                    "item": "pansy",
                    "qty": 2
                  }
                ],
                "then": [
                  {
                    "do": "take",
                    "item": "pansy",
                    "qty": 2
                  },
                  {
                    "do": "give",
                    "item": "nasturtium",
                    "qty": 1
                  },
                  {
                    "do": "toast",
                    "text": "Mrs Crewe wraps a nasturtium in a twist of paper."
                  }
                ],
                "else": [
                  {
                    "do": "toast",
                    "text": "You have not got two pansies."
                  }
                ]
              }
            ]
          },
          {
            "label": "What else?",
            "goto": "b"
          }
        ]
      },
      "b": {
        "lines": [
          "A honeylace lily, for two nasturtiums. I don't grow them. A man brings them on the Sunday train, and he has never once missed it."
        ],
        "options": [
          {
            "label": "Two nasturtiums for a lily",
            "actions": [
              {
                "do": "if",
                "when": [
                  {
                    "if": "hasItem",
                    "item": "nasturtium",
                    "qty": 2
                  }
                ],
                "then": [
                  {
                    "do": "take",
                    "item": "nasturtium",
                    "qty": 2
                  },
                  {
                    "do": "give",
                    "item": "honeylace_lily",
                    "qty": 1
                  },
                  {
                    "do": "toast",
                    "text": "A honeylace lily, its roots in damp newspaper."
                  }
                ],
                "else": [
                  {
                    "do": "toast",
                    "text": "You have not got two nasturtiums."
                  }
                ]
              }
            ]
          },
          {
            "label": "Nothing, thank you"
          }
        ]
      }
    }
  },
  "mrs_bex": {
    "speaker": "Mrs Bex",
    "start": [
      {
        "node": "a"
      }
    ],
    "nodes": {
      "a": {
        "lines": [
          "I come for eggs. There are never any eggs. I come anyway. It's somewhere to go."
        ]
      }
    }
  },
  "mr_dunn": {
    "speaker": "Mr Dunn",
    "start": [
      {
        "when": [
