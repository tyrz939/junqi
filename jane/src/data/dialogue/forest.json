{
  "notice_forest": {
    "speaker": "Council Sign",
    "start": [{ "node": "read" }],
    "nodes": {
      "read": {
        "lines": [
          "BUTTERFLY FOREST. A public garden of the county council. Open from sunrise to sunset.",
          "Do not pick the flowers. Visitors are counted in at the gate and counted out again.",
          "Below, on a newer board in a different hand: the paths have grown over. Keep to the light."
        ]
      }
    }
  },
  "forest_cases": {
    "speaker": "Glass Cases",
    "start": [
      { "when": [{ "if": "flag", "flag": "forest_butterflies", "min": 8 }, { "if": "flag", "flag": "forest_amulet", "not": true }], "node": "full" },
      { "when": [{ "if": "dead", "unit": "collector" }], "node": "after" },
      { "node": "before" }
    ],
    "nodes": {
      "before": {
        "lines": [
          "Eleven cases on the wall, each with a label in the same careful hand. The labels are trades and not species. CARTER. NURSE. SIGNALMAN.",
          "Ten of them have something in them."
        ]
      },
      "after": {
        "lines": ["The eleventh label is blank. The case is open, and there is a pin in it with nothing on the pin."]
      },
      "full": {
        "lines": ["Eight of yours, set in the order the labels were written. The blank one is the one that fits them."],
        "actions": [
          { "do": "give", "item": "butterfly_amulet" },
          { "do": "flag", "flag": "forest_amulet" }
        ]
      }
    }
  },
  "forest_hearth": {
    "speaker": "Charcoal Hearth",
    "start": [{ "node": "fire" }],
    "nodes": {
      "fire": {
        "lines": [
          "A charcoal burner's hearth, swept out, with the kettle still hung over it and next week's wood stacked.",
          "The hedge is thick on three sides and there is one way in. You can sleep here."
        ],
        "actions": [{ "do": "rest" }]
      }
    }
  },
  "forest_catch_1": {
    "speaker": "Butterfly",
    "start": [{ "when": [{ "if": "hasItem", "item": "net" }], "node": "net" }, { "node": "bare" }],
    "nodes": {
      "bare": { "lines": ["It sits on your sleeve. You have nothing to keep it in, and it seems to know."] },
